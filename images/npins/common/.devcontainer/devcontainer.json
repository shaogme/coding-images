{
  "name": "Coding Images - npins Common",
  "image": "ghcr.io/shaogme/coding-images/npins-common:latest",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteUser": "dev",
  "capAdd": [
    "SYS_ADMIN",
    "SYS_PTRACE",
    "NET_ADMIN"
  ],
  "securityOpt": [
    "seccomp=unconfined",
    "label=disable"
  ],
  "runArgs": [
    "--device=/dev/fuse",
    "--device=/dev/net/tun"
  ],
  "mounts": [
    "source=devbox-data,target=/data/devbox,type=volume",
    "source=coding-config,target=/data/coding-config,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "jnoortheen.nix-ide",
        "ms-python.python",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
