{
  "name": "Coding Images - npins Common",
  "image": "ghcr.io/shaogme/coding-images/npins-common:latest",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteUser": "dev",
  "capAdd": [
    "SYS_ADMIN",
    "SYS_PTRACE",
    "NET_ADMIN"
  ],
  "securityOpt": [
    "seccomp=unconfined"
  ],
  "containerEnv": {
    "ROOT_PASSWORD": "root",
    "MISE_YES": "1"
  },
  "mounts": [
    "source=direnv-data,target=/data/direnv,type=volume",
    "source=coding-config,target=/data/coding-config,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "jnoortheen.nix-ide",
        "ms-python.python",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
