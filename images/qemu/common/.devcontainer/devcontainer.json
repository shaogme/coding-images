{
  "name": "Coding Images - QEMU Common",
  "image": "ghcr.io/shaogme/coding-images/qemu-common:latest",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteUser": "dev",
  "capAdd": [
    "SYS_ADMIN",
    "NET_ADMIN"
  ],
  "securityOpt": [
    "seccomp=unconfined",
    "apparmor=unconfined",
    "systempaths=unconfined"
  ],
  "runArgs": [
    "--device=/dev/kvm",
    "--device=/dev/net/tun",
    "--device=/dev/fuse"
  ],
  "mounts": [
    "source=qemu-data,target=/data/qemu,type=volume",
    "source=podman-containers,target=/var/lib/containers,type=volume",
    "source=cache,target=/data/cache,type=volume",
    "source=devbox-data,target=/data/devbox,type=volume",
    "source=coding-config,target=/data/coding-config,type=volume"
  ]
}
