{
  "name": "Coding Images - Podman",
  "image": "ghcr.io/shaogme/coding-images/podman:latest",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteUser": "dev",
  "capAdd": [
    "SYS_ADMIN",
    "SYS_PTRACE",
    "NET_ADMIN"
  ],
  "securityOpt": [
    "seccomp=unconfined",
    "label=disable"
  ],
  "runArgs": [
    "--device=/dev/fuse",
    "--device=/dev/net/tun"
  ],
  "containerEnv": {
    "ROOT_PASSWORD": "root"
  },
  "mounts": [
    "source=podman-containers,target=/var/lib/containers,type=volume",
    "source=devbox-data,target=/data/devbox,type=volume",
    "source=coding-config,target=/data/coding-config,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
