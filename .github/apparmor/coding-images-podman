# Rootless Podman creates a user namespace and re-execs itself through
# /proc/self/exe. Ubuntu's unprivileged_userns profile otherwise rejects that
# exec. Keep this exception narrow to the Podman executable supplied by the
# coding-images Nix profile (and its resolved Nix store path).

abi <abi/4.0>,
include <tunables/global>

profile coding-images-podman /nix/{var/nix/profiles/default/bin/podman,store/*-podman-*/bin/podman} flags=(unconfined) {
  userns,
}
